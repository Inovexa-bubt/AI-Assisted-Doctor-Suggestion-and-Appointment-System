{
  "name": "@inovexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "eval:ai": "tsx src/scripts/eval-ai.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@inovexa/shared": "*",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.0",
    "tsx": "^4.20.6"
  }
}
