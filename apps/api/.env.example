# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Database
# PostgreSQL 16+ connection string, e.g.:
#   postgres://postgres:postgres@localhost:5432/lumina_hospital
# Leave unset or use pglite://./data/pglite to run an embedded local PostgreSQL database.
DATABASE_URL=pglite://./data/pglite

# AI Triage Provider: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text Provider: mock | gemini | openai
STT_PROVIDER=mock
STT_OPENAI_MODEL=whisper-1

# SMS Gateway Provider: sandbox | bulksmsbd | webhook
# In sandbox mode (and non-production), OTP requests also return demoCode in JSON.
SMS_PROVIDER=sandbox
SMS_API_KEY=
SMS_SENDER_ID=LuminaHosp
SMS_WEBHOOK_URL=

# Background scheduler (expired hold cleanup + reminder SMS)
ENABLE_SCHEDULER=true

# Set true to serve the built frontend (apps/web/dist) directly from this Node server
# (useful for Docker / Render / Railway; keep false when Nginx serves static files)
SERVE_STATIC=false
